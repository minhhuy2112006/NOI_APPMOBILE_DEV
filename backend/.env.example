NODE_ENV=development

PORT=3000

DATABASE_URL=postgresql://noi:noi_dev_password@localhost:5432/noi

DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

LOG_LEVEL=info
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

JWT_ISSUER=noi-backend
JWT_AUDIENCE=noi-mobile